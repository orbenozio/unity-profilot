{
  "name": "profilot",
  "version": "0.8.0",
  "description": "CLI for Profilot - prints the Unity performance events Profilot captured in Editor Play Mode as JSON for Claude Code.",
  "bin": {
    "profilot": "index.js"
  },
  "files": [
    "index.js",
    "profilot-diagnosis-guide.md",
    "profilot-field-reference.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepack": "node -e \"const fs=require('fs');for(const f of ['profilot-diagnosis-guide.md','profilot-field-reference.md','LICENSE'])fs.copyFileSync('../'+f,f)\""
  },
  "type": "commonjs",
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "unity",
    "unity3d",
    "profiler",
    "performance",
    "claude",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbenozio/unity-profilot.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/orbenozio/unity-profilot#readme",
  "bugs": {
    "url": "https://github.com/orbenozio/unity-profilot/issues"
  },
  "author": "Or Benozio",
  "license": "MIT"
}
